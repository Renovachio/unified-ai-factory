{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-ai-factory.local/contracts/v2.2/skill-manifest.schema.json",
  "title": "SkillManifest v2.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "slug",
    "version",
    "digest",
    "origin",
    "permissions",
    "runtimeCompatibility"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.2"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "version": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "origin": {
      "type": "object",
      "required": [
        "uri",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "local",
            "upload",
            "git",
            "catalog"
          ]
        },
        "revision": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "licenseReview": {
          "type": "string",
          "enum": [
            "approved",
            "blocked",
            "pending"
          ]
        }
      }
    },
    "permissions": {
      "type": "object",
      "required": [
        "tools",
        "network",
        "writeScopes"
      ],
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "network": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "writeScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dataClasses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "runtimeCompatibility": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "claude_code_cli",
          "codex_cli",
          "local_model"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "digest"
        ],
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
