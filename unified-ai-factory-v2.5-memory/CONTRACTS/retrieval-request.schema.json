{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dispatch.invalid/schemas/retrieval-request.schema.json",
  "title": "retrieval-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projectId",
    "query",
    "purpose",
    "maxTokens"
  ],
  "properties": {
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "enum": [
        "pm_research",
        "pm_decision",
        "engineering",
        "user_answer",
        "historical_audit"
      ]
    },
    "maxTokens": {
      "type": "integer",
      "minimum": 128,
      "maximum": 100000
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "requiredSourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "topK": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  }
}
