{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dispatch.invalid/schemas/memory-record.schema.json",
  "title": "memory-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenantId",
    "projectId",
    "kind",
    "status",
    "sourceIds",
    "sourceDigest",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "episodic",
        "semantic",
        "procedural",
        "preference"
      ]
    },
    "status": {
      "enum": [
        "proposed",
        "verified",
        "approved",
        "disputed",
        "superseded",
        "expired",
        "deleted"
      ]
    },
    "claim": {
      "type": "string"
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "sourceDigest": {
      "type": "string",
      "minLength": 1
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "validTo": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
