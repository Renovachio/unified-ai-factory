{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-ai-factory.local/contracts/v2.2/agent-manifest.schema.json",
  "title": "AgentManifest v2.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "digest",
    "purpose",
    "skills",
    "tools",
    "humanGates",
    "runtimeModes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "2.2"
    },
    "name": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "purpose": {
      "type": "string",
      "minLength": 10
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "digest"
        ],
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "humanGates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtimeModes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "subscription_cli",
          "local_model"
        ]
      }
    },
    "maxRuntimeSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "dataScopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
