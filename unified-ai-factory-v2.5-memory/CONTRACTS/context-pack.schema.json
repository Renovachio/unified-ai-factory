{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.dispatch.invalid/schemas/context-pack.schema.json",
  "title": "context-pack.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "jobId",
    "projectId",
    "memoryRefs",
    "estimatedInputTokens",
    "selectionConfigDigest"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "projectId": {
      "type": "string",
      "format": "uuid"
    },
    "memoryRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "recordId",
          "version",
          "sourceDigest",
          "estimatedTokens"
        ],
        "additionalProperties": false,
        "properties": {
          "recordId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "sourceDigest": {
            "type": "string",
            "minLength": 1
          },
          "estimatedTokens": {
            "type": "integer",
            "minimum": 0
          },
          "selectionReason": {
            "type": "string"
          }
        }
      }
    },
    "estimatedInputTokens": {
      "type": "integer",
      "minimum": 0
    },
    "actualInputTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "omissionReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selectionConfigDigest": {
      "type": "string",
      "minLength": 1
    }
  }
}
