{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FactoryEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "job_id",
    "attempt",
    "fencing_token",
    "sequence",
    "timestamp",
    "type",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "fencing_token": {
      "type": "integer",
      "minimum": 0
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  }
}
